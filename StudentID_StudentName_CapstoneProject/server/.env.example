# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/folio?retryWrites=true&w=majority

# Use a long random value in production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# Optional seed account overrides (used by `npm run seed`)
ADMIN_USERNAME=alex
ADMIN_EMAIL=admin@folio.dev
ADMIN_PASSWORD=Admin123!
